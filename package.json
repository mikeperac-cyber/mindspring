{
  "name": "mindspring",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/ios",
    "packages/mindspring-core"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "ios:start": "npm run start --workspace @mindspring/ios",
    "test:ios": "npm run test --workspace @mindspring/ios --",
    "typecheck:ios": "npm run typecheck --workspace @mindspring/ios"
  },
  "dependencies": {
    "@mindspring/core": "1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
